# Environment / secrets
# `.env` matches at any depth, so frontend/.env is covered too. The `.local` patterns are the
# Vite convention for machine-local overrides and are the easiest file to commit by accident.
# `.env.example` is negated last so it stays tracked - it is the template and holds no secret.
.env
.env.*
.env*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp*/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Evaluation runs contain model predictions and candidate-answer text. Keep each local run
# immutable and out of source control; public protocols and locks remain versioned.
backend/evals/results/
# Frozen reviews and labels contain historical candidate answers/context. Their public
# locks remain versioned; restore the byte-locked originals for the private gate.
backend/evals/labels/*.csv
backend/evals/reviews/
backend/evals/recovery_v11/human_review/
backend/evals/recovery_v11/artifacts/20261011T223751Z/claim_score_addendum_v1.1a/scores_band_review_v1.1a.csv
backend/evals/recovery_v11/artifacts/20261011T223751Z/claim_score_addendum_v1.1a/results_v1.1a/
backend/evals/recovery_v11/artifacts/20261011T223751Z/claim_validity_v1.1/claims_initial_blind.csv
backend/evals/recovery_v11/artifacts/20261011T223751Z/claim_validity_v1.1/inventory.json
backend/evals/recovery_v11/artifacts/20261011T223751Z/evidence_review_frozen/evidence_source_review_frozen.csv
backend/evals/recovery_v11/artifacts/20261011T223751Z/evidence_source_review_blind*.csv

# Node
node_modules/
dist/

# Datasets: keep the directory structure, ignore the contents. Raw O*NET downloads are large
# and are only an input to the notebook pipeline; derived artifacts are rebuilt from them.
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# ...with one deliberate exception. `onet_kb.jsonl` is the single derived artifact the running
# application reads (backend/app/knowledge/onet_kb.py, via Settings.onet_kb_path), and without
# it every interview-plan request fails. It is generated by a notebook that needs the
# multi-hundred-MB raw O*NET database, so a deployment cannot rebuild it - tracking it is what
# makes a deploy reproducible from the repository alone. ~4.7 MB on disk, ~0.7 MB compressed in
# git, and it only changes when O*NET publishes a new release. O*NET is public U.S. Department
# of Labor data and may be redistributed with attribution; see backend/data/README.md.
# The CSV index and meta JSON stay ignored: they are for inspection, not for the application.
!backend/data/processed/onet/
backend/data/processed/onet/*
!backend/data/processed/onet/onet_kb.jsonl

# Local AI/agent tooling. Machine-local working state, not project source: it belongs to
# whoever is working in this checkout, not to the repository. Anchored to the root so nothing
# with a similar name deeper in the tree is hidden by accident.
/.agents/
/.claude/
/.codex/
/.impeccable/
/PRODUCT.md
/skills-lock.json

# OS / editor
.DS_Store
.idea/
.vscode/
