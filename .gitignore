# Environment / secrets
# `.env` matches at any depth, so frontend/.env is covered too. The `.local` patterns are the
# Vite convention for machine-local overrides and are the easiest file to commit by accident.
# `.env.example` is negated last so it stays tracked - it is the template and holds no secret.
.env
.env.*
.env*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Node
node_modules/
dist/

# Datasets: keep the directory structure, ignore the contents. Raw O*NET downloads are large
# and are only an input to the notebook pipeline; derived artifacts are rebuilt from them.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ...with one deliberate exception. `onet_kb.jsonl` is the single derived artifact the running
# application reads (app/knowledge/onet_kb.py, via Settings.onet_kb_path), and without it every
# interview-plan request fails. It is generated by a notebook that needs the multi-hundred-MB raw
# O*NET database, so a deployment cannot rebuild it - tracking it is what makes a deploy
# reproducible from the repository alone. ~4.7 MB on disk, ~0.7 MB compressed in git, and it only
# changes when O*NET publishes a new release. O*NET is public U.S. Department of Labor data and
# may be redistributed with attribution; see data/README.md.
# The CSV index and meta JSON stay ignored: they are for inspection, not for the application.
!data/processed/onet/
data/processed/onet/*
!data/processed/onet/onet_kb.jsonl

# Local AI/agent tooling. Machine-local working state, not project source: it belongs to
# whoever is working in this checkout, not to the repository. Anchored to the root so nothing
# with a similar name deeper in the tree is hidden by accident.
/.agents/
/.claude/
/.codex/
/.impeccable/
/PRODUCT.md
/skills-lock.json

# OS / editor
.DS_Store
.idea/
.vscode/
