# Placeholder values only. Set these in the ISOLATED staging backend project, never in Vite.
# Use Neon's pooled hostname (contains -pooler) for runtime traffic.
DATABASE_URL=postgresql+asyncpg://intermind_app_runtime:<URL_ENCODED_PASSWORD>@<STAGING_POOLED_HOST>/intermind_staging
DATABASE_SSL_VERIFY_FULL=true
REQUIRE_DATABASE=true
SHARED_STATE_BACKEND=postgres
DATABASE_POOL_MODE=null
DATABASE_ECHO=false
RECRUITER_SESSION_COOKIE_SECURE=true
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=<STAGING_OPENAI_API_KEY>
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
REQUEST_DEADLINE_SECONDS=105
SPEECH_PROVIDER=azure
AZURE_SPEECH_AUTH=key
AZURE_SPEECH_REGION=<STAGING_SPEECH_REGION>
AZURE_SPEECH_KEY=<STAGING_SPEECH_F0_KEY>
ALLOWED_ORIGINS=https://<STAGING_FRONTEND_HOST>
LOG_LEVEL=INFO
# The retention route is disabled until the new migration and isolated smoke check pass.
RETENTION_ENABLED=false
INTERVIEW_RETENTION_DAYS=90
# Set only in the backend's Production environment when activating the daily cron.
CRON_SECRET=<INDEPENDENT_RANDOM_STAGING_SECRET>
