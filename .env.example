# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Which LLM implementation to use: "fake" (deterministic, offline) or "openai".
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=openai. Never hardcode this in source.
OPENAI_API_KEY=

# Model used for structured extraction when LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-4o-mini

# Root log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API cross-origin. Never "*".
# Production: your frontend's own origin, e.g. https://intermind.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------------------
# PostgreSQL. Required in any deployment - without it the app runs on in-memory storage and
# nothing survives a restart. `postgres://` and a missing `+asyncpg` are normalised for you.
# Azure: postgresql://user:pass@server.postgres.database.azure.com:5432/intermind?ssl=require
DATABASE_URL=

# --- Recruiter sessions ------------------------------------------------------------------
# Recruiters register themselves at /signup and their accounts live in PostgreSQL. There is no
# configured account and no shared credential: RECRUITER_EMAIL, RECRUITER_PASSWORD_HASH and
# RECRUITER_ACCESS_TOKEN have all been removed. See docs/recruiter-auth.md.

# How long a recruiter session lasts, in seconds (default 8 hours). Sessions are in-memory and
# end when the backend restarts.
# RECRUITER_SESSION_TTL_SECONDS=28800

# Set to true wherever the app is served over HTTPS, so the session cookie carries `Secure`.
# Left false for local http://localhost development, where a Secure cookie is never stored.
RECRUITER_SESSION_COOKIE_SECURE=false

# --- Speech-to-text ---------------------------------------------------------------------
# Which STT implementation the candidate interview uses:
#   azure    - Azure AI Speech (production). Requires the settings below.
#   browser  - the browser's own Web Speech API. Recognition quality is poor in real Chrome;
#              kept for offline development only.
#   disabled - no voice input at all; candidates type. Always a safe value.
# The frontend has its own VITE_SPEECH_PROVIDER (frontend/.env.example) and the two should
# match; the backend value is what actually gates token issuance.
SPEECH_PROVIDER=browser

# Azure region short name, e.g. westeurope / eastus. Required when SPEECH_PROVIDER=azure.
AZURE_SPEECH_REGION=

# LOCAL DEVELOPMENT ONLY. The backend exchanges this for a 10-minute token that the browser
# receives; the key itself is never sent to a client and must never be given a VITE_ prefix.
# Leave EMPTY in Azure and use managed identity instead (see the two settings below).
AZURE_SPEECH_KEY=

# PRODUCTION (managed identity). Set these *instead of* AZURE_SPEECH_KEY. Needs the `azure`
# extra installed (pip install -e ".[azure]") and the identity to hold the
# "Cognitive Services Speech User" role on the resource.
# Full ARM resource id: /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
AZURE_SPEECH_RESOURCE_ID=
# Custom subdomain host, e.g. my-speech.cognitiveservices.azure.com. Managed identity requires
# the resource to have a custom domain.
AZURE_SPEECH_HOST=

# Recognition language for the interview.
AZURE_SPEECH_LANGUAGE=en-US
